# Copy to `.env` (git-ignored) and fill in. All three are optional.

# Where the sign-up pills POST the visitor's email as JSON.
# Formspree: create a form at https://formspree.io, paste its endpoint here.
# Leave empty and the pills fall back to opening the visitor's mail client.
VITE_FORM_ENDPOINT=

# Only for Web3Forms (https://web3forms.com) — sent as `access_key`.
VITE_FORM_ACCESS_KEY=

# Inbox the mailto fallback (and the final CTA button) is addressed to.
VITE_CONTACT_EMAIL=hello@planetowl.studio
